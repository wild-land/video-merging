# 飞牛 NAS 中录像根目录（包含 P100000000001/01/YYYYMMDD 等目录）
EASYNVR_RECORDINGS=/vol1/your-path/easynvr_rec
# 合并结果目录，必须与录像目录分开
MERGED_OUTPUT=/vol1/your-path/easynvr_merged
# SQLite 数据库与持久化日志目录
APP_DATA_PATH=./data
WEB_PORT=8080
TZ=Asia/Shanghai
# 建议设置；两项都有值时启用浏览器 Basic Auth
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-strong-password
